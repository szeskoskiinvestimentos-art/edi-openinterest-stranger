def save_to_cache(data, cache_key):
    """Salva dados no cache local"""
    try:
        cache_file = os.path.join(CACHE_DIR, f"{cache_key}.json")
        with open(cache_file, 'w') as f:
            json.dump({
                'timestamp': datetime.now().timestamp(),
                'data': data
            }, f)
        logging.info(f"Dados salvos em cache: {cache_key}")
        return True
    except Exception as e:
        logging.warning(f"Erro ao salvar cache: {str(e)}")
        return False

def load_from_cache(cache_key, max_age_hours=24):
    """Carrega dados do cache local se não estiverem expirados"""
    try:
        cache_file = os.path.join(CACHE_DIR, f"{cache_key}.json")
        if not os.path.exists(cache_file):
            return None
        
        with open(cache_file, 'r') as f:
            cache_data = json.load(f)
        
        # Verificar idade do cache
        cache_time = cache_data.get('timestamp', 0)
        current_time = datetime.now().timestamp()
        age_hours = (current_time - cache_time) / 3600
        
        if age_hours <= max_age_hours:
            logging.info(f"Usando dados em cache para {cache_key} (idade: {age_hours:.1f} horas)")
            return cache_data.get('data')
        else:
            logging.info(f"Cache expirado para {cache_key} (idade: {age_hours:.1f} horas)")
            return None
    except Exception as e:
        logging.warning(f"Erro ao carregar cache: {str(e)}")
        return None

def list_available_cache():
    """Lista todos os arquivos de cache disponíveis"""
    try:
        cache_files = [f for f in os.listdir(CACHE_DIR) if f.endswith('.json')]
        cache_info = []
        
        for file in cache_files:
            try:
                cache_path = os.path.join(CACHE_DIR, file)
                with open(cache_path, 'r') as f:
                    cache_data = json.load(f)
                
                timestamp = cache_data.get('timestamp', 0)
                cache_date = datetime.fromtimestamp(timestamp).strftime('%Y-%m-%d %H:%M:%S')
                cache_key = file.replace('.json', '')
                
                cache_info.append({
                    'key': cache_key,
                    'date': cache_date,
                    'age_hours': (datetime.now().timestamp() - timestamp) / 3600
                })
            except:
                pass
        
        return cache_info
    except Exception as e:
        logging.warning(f"Erro ao listar cache: {str(e)}")
        return []

def get_dolar_options_data(min_volume=5, use_cache=True, force_refresh=False):
    """
    Obtém dados de opções de dólar do Yahoo Finance.
    
    Tickers testados:
    - DX-Y.NYB: US Dollar Index
    - UUP: Invesco DB US Dollar Index Bullish Fund
    - UDN: Invesco DB US Dollar Index Bearish Fund
    - USDU: WisdomTree Bloomberg U.S. Dollar Bullish Fund
    
    Args:
        min_volume (int): Volume mínimo para filtrar opções (padrão: 5)
        use_cache (bool): Se deve usar cache quando disponível
        force_refresh (bool): Se deve forçar atualização mesmo com cache válido
        
    Returns:
        pandas.DataFrame: DataFrame com dados de opções filtrados
    """
    # Lista de tickers a tentar, em ordem de prioridade
    tickers = ["UUP", "UDN", "USDU", "DX-Y.NYB"]
    
    # Tentar cada ticker até encontrar um com dados válidos
    for ticker in tickers:
        logging.info(f"Tentando obter dados de opções para {ticker}...")
        
        cache_key = f"dolar_options_{ticker}"
        
        # Tentar carregar do cache se permitido
        if use_cache and not force_refresh:
            cached_data = load_from_cache(cache_key)
            if cached_data:
                # Converter para DataFrame
                try:
                    df = pd.DataFrame(cached_data)
                    # Filtrar por volume mínimo
                    df_filtered = df[df['open_interest'] >= min_volume]
                    logging.info(f"Dados carregados do cache para {ticker}: {len(df)} opções totais, {len(df_filtered)} após filtro")
                    return df_filtered, ticker
                except Exception as e:
                    logging.warning(f"Erro ao processar dados do cache para {ticker}: {str(e)}")
                    # Continuar com busca online se cache falhar
        
        try:
            # Adicionar espera aleatória para evitar rate limiting
            wait_time = random.uniform(1.0, 3.0)
            logging.info(f"Aguardando {wait_time:.1f} segundos antes da requisição...")
            time.sleep(wait_time)
            
            # Obter dados do ticker
            dolar = yf.Ticker(ticker)
            
            # Verificar se o ticker é válido
            try:
                info = dolar.info
                if info.get('regularMarketPrice') is None:
                    logging.warning(f"Não foi possível obter dados para o ticker {ticker}, tentando próximo...")
                    continue
                
                # Registrar informações sobre o ticker
                ticker_name = info.get('shortName', ticker)
                current_price = info.get('regularMarketPrice', 0)
                logging.info(f"Ticker válido: {ticker_name} (Preço atual: {current_price})")
                
            except Exception as e:
                if "Too Many Requests" in str(e):
                    logging.error(f"Yahoo Finance retornou erro de limite de requisições (Rate Limit) para {ticker}")
                    # Tentar usar cache mesmo que expirado em caso de rate limit
                    cached_data = load_from_cache(cache_key, max_age_hours=168)  # Aceitar cache de até 7 dias
                    if cached_data:
                        logging.info(f"Usando cache expirado para {ticker} devido a limite de requisições")
                        df = pd.DataFrame(cached_data)
                        df_filtered = df[df['open_interest'] >= min_volume]
                        return df_filtered, ticker
                else:
                    logging.error(f"Erro ao verificar ticker {ticker}: {str(e)}")
                continue
            
            # Obter datas de vencimento disponíveis
            try:
                expiry_dates = dolar.options
                if not expiry_dates:
                    logging.warning(f"Nenhuma data de vencimento encontrada para {ticker}, tentando próximo...")
                    continue
                
                logging.info(f"Encontradas {len(expiry_dates)} datas de vencimento para {ticker}")
            except Exception as e:
                if "Too Many Requests" in str(e):
                    logging.error(f"Yahoo Finance retornou erro de limite de requisições (Rate Limit) para {ticker}")
                    # Tentar usar cache mesmo que expirado em caso de rate limit
                    cached_data = load_from_cache(cache_key, max_age_hours=168)  # Aceitar cache de até 7 dias
                    if cached_data:
                        logging.info(f"Usando cache expirado para {ticker} devido a limite de requisições")
                        df = pd.DataFrame(cached_data)
                        df_filtered = df[df['open_interest'] >= min_volume]
                        return df_filtered, ticker
                else:
                    logging.error(f"Erro ao obter datas de vencimento para {ticker}: {str(e)}")
                continue
            
            # Lista para armazenar todos os dados de opções
            all_options = []
            
            # Processar cada data de vencimento
            for expiry in expiry_dates:
                try:
                    logging.info(f"Processando vencimento: {expiry}")
                    
                    # Adicionar espera entre requisições para evitar rate limiting
                    time.sleep(random.uniform(0.5, 1.5))
                    
                    # Obter opções para esta data de vencimento
                    opt = dolar.option_chain(expiry)
                    
                    # Processar calls
                    if not opt.calls.empty:
                        # Adicionar coluna de tipo e data de vencimento
                        calls = opt.calls.copy()
                        calls['type'] = 'call'
                        calls['expiry'] = expiry
                        
                        # Selecionar e renomear colunas relevantes
                        calls = calls[['strike', 'type', 'openInterest', 'expiry']]
                        calls.rename(columns={'openInterest': 'open_interest'}, inplace=True)
                        
                        # Adicionar à lista
                        all_options.append(calls)
                    
                    # Processar puts
                    if not opt.puts.empty:
                        # Adicionar coluna de tipo e data de vencimento
                        puts = opt.puts.copy()
                        puts['type'] = 'put'
                        puts['expiry'] = expiry
                        
                        # Selecionar e renomear colunas relevantes
                        puts = puts[['strike', 'type', 'openInterest', 'expiry']]
                        puts.rename(columns={'openInterest': 'open_interest'}, inplace=True)
                        
                        # Adicionar à lista
                        all_options.append(puts)
                    
                except Exception as e:
                    if "Too Many Requests" in str(e):
                        logging.error(f"Limite de requisições atingido ao processar {expiry} para {ticker}. Tentando próximo vencimento.")
                    else:
                        logging.error(f"Erro ao processar vencimento {expiry} para {ticker}: {str(e)}")
                    continue
            
            # Verificar se temos dados
            if not all_options:
                logging.warning(f"Nenhum dado de opção encontrado para {ticker}, tentando próximo...")
                continue
            
            # Concatenar todos os dados
            df = pd.concat(all_options, ignore_index=True)
            
            # Converter open_interest para numérico e preencher NaN com 0
            df['open_interest'] = pd.to_numeric(df['open_interest'], errors='coerce').fillna(0).astype(int)
            
            # Converter datas para formato YYYY-MM-DD
            df['expiry'] = pd.to_datetime(df['expiry']).dt.strftime('%Y-%m-%d')
            
            # Salvar em cache
            save_to_cache(df.to_dict('records'), cache_key)
            
            # Filtrar por volume mínimo
            df_filtered = df[df['open_interest'] >= min_volume]
            
            # Log de resultados
            total_options = len(df)
            filtered_options = len(df_filtered)
            logging.info(f"Total de opções encontradas para {ticker}: {total_options}")
            logging.info(f"Opções após filtro de volume mínimo ({min_volume}): {filtered_options}")
            
            if filtered_options > 0:
                # Mostrar estatísticas por data de vencimento
                expiries = sorted(df_filtered['expiry'].unique())
                logging.info(f"Datas de vencimento disponíveis após filtro: {len(expiries)}")
                
                for expiry in expiries[:5]:  # Mostrar até 5 vencimentos
                    expiry_data = df_filtered[df_filtered['expiry'] == expiry]
                    calls = len(expiry_data[expiry_data['type'] == 'call'])
                    puts = len(expiry_data[expiry_data['type'] == 'put'])
                    logging.info(f"Vencimento {expiry}: {len(expiry_data)} opções (Calls: {calls}, Puts: {puts})")
                
                return df_filtered, ticker
            else:
                logging.warning(f"Nenhuma opção com volume mínimo {min_volume} encontrada para {ticker}, tentando próximo...")
                continue
            
        except Exception as e:
            logging.error(f"Erro ao buscar dados de opções para {ticker}: {str(e)}")
            logging.error(traceback.format_exc())
            continue
    
    # Se chegou aqui, nenhum ticker funcionou
    logging.error("Não foi possível obter dados de opções para nenhum dos tickers testados")
    
    # Tentar usar cache de qualquer ticker como último recurso
    for ticker in tickers:
        cache_key = f"dolar_options_{ticker}"
        cached_data = load_from_cache(cache_key, max_age_hours=168)  # Aceitar cache de até 7 dias
        if cached_data:
            logging.info(f"Usando cache de {ticker} como último recurso")
            df = pd.DataFrame(cached_data)
            df_filtered = df[df['open_interest'] >= min_volume]
            return df_filtered, ticker
    
    # Se realmente não há dados, retornar DataFrame vazio
    return pd.DataFrame(columns=["strike", "type", "open_interest", "expiry"]), None

def get_cached_options_data(min_volume=5):
    """
    Retorna apenas dados em cache, sem tentar buscar online.
    Útil para modo offline.
    """
    # Lista de tickers a tentar, em ordem de prioridade
    tickers = ["UUP", "UDN", "USDU", "DX-Y.NYB"]
    
    # Tentar cada ticker até encontrar um com dados válidos em cache
    for ticker in tickers:
        cache_key = f"dolar_options_{ticker}"
        
        cached_data = load_from_cache(cache_key, max_age_hours=float('inf'))  # Sem limite de idade
        if cached_data:
            df = pd.DataFrame(cached_data)
            df_filtered = df[df['open_interest'] >= min_volume]
            logging.info(f"Dados carregados do cache para {ticker} (modo offline): {len(df)} opções totais, {len(df_filtered)} após filtro")
