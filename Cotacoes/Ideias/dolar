class DolarOptionsViewer:
    def __init__(self, root):
        self.root = root
        self.root.title("Visualizador de Opções de Dólar")
        self.root.geometry("1000x600")
        self.root.minsize(800, 500)
        
        # Configurar estilo
        style = ttk.Style()
        style.configure("TButton", padding=6, relief="flat", background="#ccc")
        style.configure("TLabel", padding=6)
        style.configure("TFrame", background="#f0f0f0")
        
        # Variáveis
        self.data = pd.DataFrame()
        self.expiry_dates = []
        self.selected_expiry = tk.StringVar()
        self.status_text = tk.StringVar(value="Carregando dados...")
        self.use_cache_only = tk.BooleanVar(value=False)
        self.min_volume = tk.IntVar(value=5)
        self.loading = False
        self.cache_info = []
        self.ticker_used = None
        
        # Criar layout
        self.create_widgets()
        
        # Carregar dados iniciais
        self.root.after(100, self.load_data)
    
    def create_widgets(self):
        # Frame principal
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.pack(fill=tk.BOTH, expand=True)
        
        # Frame superior para controles
        control_frame = ttk.Frame(main_frame)
        control_frame.pack(fill=tk.X, pady=(0, 10))
        
        # Botão para atualizar dados
        refresh_btn = ttk.Button(control_frame, text="Atualizar Dados e Gráfico", command=self.load_data)
        refresh_btn.pack(side=tk.LEFT, padx=5)
        
        # Seletor de data de vencimento
        expiry_label = ttk.Label(control_frame, text="Data de Vencimento:")
        expiry_label.pack(side=tk.LEFT, padx=(20, 5))
        
        self.expiry_combo = ttk.Combobox(control_frame, textvariable=self.selected_expiry, state="readonly", width=15)
        self.expiry_combo.pack(side=tk.LEFT, padx=5)
        self.expiry_combo.bind("<<ComboboxSelected>>", self.on_expiry_selected)
        
        # Checkbox para usar apenas cache
        cache_check = ttk.Checkbutton(control_frame, text="Usar Dados em Cache", variable=self.use_cache_only)
        cache_check.pack(side=tk.RIGHT, padx=5)
        
        # Status bar
        status_bar = ttk.Label(main_frame, textvariable=self.status_text, relief=tk.SUNKEN, anchor=tk.W)
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)
        
        # Frame para o gráfico
        self.chart_frame = ttk.Frame(main_frame)
        self.chart_frame.pack(fill=tk.BOTH, expand=True)
        
        # Criar figura do matplotlib
        self.fig = Figure(figsize=(10, 6), dpi=100)
        self.ax = self.fig.add_subplot(111)
        
        # Incorporar figura no tkinter
        self.canvas = FigureCanvasTkAgg(self.fig, master=self.chart_frame)
        self.canvas.draw()
        self.canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)
        
        # Adicionar barra de ferramentas de navegação
        from matplotlib.backends.backend_tkagg import NavigationToolbar2Tk
        toolbar = NavigationToolbar2Tk(self.canvas, self.chart_frame)
        toolbar.update()
    
    def load_data(self):
        """Carrega os dados de opções em uma thread separada"""
        if self.loading:
            messagebox.showinfo("Processando", "Já existe um carregamento em andamento. Por favor, aguarde.")
            return
        
        self.loading = True
        self.status_text.set("Carregando dados...")
        
        # Desabilitar controles durante o carregamento
        self.expiry_combo.config(state="disabled")
        
        # Iniciar thread para não bloquear a interface
        thread = threading.Thread(target=self._load_data_thread)
        thread.daemon = True
        thread.start()
    
    def _load_data_thread(self):
        """Thread para carregar dados sem bloquear a interface"""
        try:
            # Verificar se deve usar apenas cache
            if self.use_cache_only.get():
                self.data, self.ticker_used = get_cached_options_data(min_volume=self.min_volume.get())
                if self.ticker_used:
                    self.root.after(0, lambda: self.status_text.set(f"Usando dados em cache ({self.ticker_used})"))
                else:
                    self.root.after(0, lambda: self.status_text.set("Usando dados em cache"))
            else:
                self.data, self.ticker_used = get_dolar_options_data(min_volume=self.min_volume.get(), use_cache=True)
                if self.ticker_used:
                    self.root.after(0, lambda: self.status_text.set(f"Dados atualizados ({self.ticker_used})"))
                else:
                    self.root.after(0, lambda: self.status_text.set("Dados atualizados"))
            
            # Atualizar lista de datas de vencimento
            if not self.data.empty:
                self.expiry_dates = sorted(self.data['expiry'].unique())
                
                # Atualizar combobox na thread principal
                self.root.after(0, self._update_expiry_combo)
            else:
                self.root.after(0, self._show_no_data_message)
        except Exception as e:
            error_msg = f"Erro ao carregar dados: {str(e)}"
            logging.error(error_msg)
            logging.error(traceback.format_exc())
            self.root.after(0, lambda: messagebox.showerror("Erro", error_msg))
            self.root.after(0, lambda: self.status_text.set("Erro ao carregar dados"))
        finally:
            self.loading = False
            self.root.after(0, lambda: self.expiry_combo.config(state="readonly"))
    
    def _update_expiry_combo(self):
        """Atualiza o combobox de datas de vencimento"""
        self.expiry_combo['values'] = self.expiry_dates
        
        if self.expiry_dates:
            # Selecionar a primeira data
            self.selected_expiry.set(self.expiry_dates[0])
            self.update_chart()
        else:
            self.selected_expiry.set("")
            self._show_no_data_message()
    
    def _show_no_data_message(self):
        """Mostra mensagem quando não há dados disponíveis"""
        messagebox.showwarning("Sem Dados", 
                              "Não foi possível obter dados de opções para o Dólar.\n\n"
                              "Possíveis causas:\n"
                              "- Problemas de conexão com o Yahoo Finance\n"
                              "- Limite de requisições atingido\n"
                              "- Não há dados de opções disponíveis\n\n"
                              "Sugestões:\n"
                              "- Tente novamente mais tarde\n"
                              "- Marque a opção 'Usar Dados em Cache' se disponível")
        
        # Limpar gráfico
        self.ax.clear()
        self.ax.set_title("Sem dados disponíveis")
        self.canvas.draw()
        
        # Atualizar status
        self.status_text.set("Sem dados disponíveis")
    
    def on_expiry_selected(self, event):
        """Manipulador para mudança na data de vencimento selecionada"""
        self.update_chart()
    
    def update_chart(self):
        """Atualiza o gráfico com os dados da data de vencimento selecionada"""
        expiry = self.selected_expiry.get()
        if not expiry or self.data.empty:
            return
        
        # Filtrar dados para a data de vencimento selecionada
        df_expiry = self.data[self.data['expiry'] == expiry]
        
        if df_expiry.empty:
            messagebox.showinfo("Sem Dados", f"Não há dados disponíveis para o vencimento {expiry}")
            return
        
        # Separar calls e puts
        calls = df_expiry[df_expiry['type'] == 'call']
        puts = df_expiry[df_expiry['type'] == 'put']
        
        # Limpar gráfico anterior
        self.ax.clear()
        
        # Plotar dados
        if not calls.empty:
            self.ax.bar(calls['strike'], calls['open_interest'], width=0.5, alpha=0.7, color='green', label='Calls')
        
        if not puts.empty:
            self.ax.bar(puts['strike'], puts['open_interest'], width=0.5, alpha=0.7, color='red', label='Puts')
        
        # Configurar gráfico
        title = f"Open Interest de Opções de Dólar - Vencimento {expiry}"
        if self.ticker_used:
            title += f" ({self.ticker_used})"
        self.ax.set_title(title)
        self.ax.set_xlabel('Strike')
        self.ax.set_ylabel('Open Interest')
        self.ax.legend()
        self.ax.grid(True, linestyle='--', alpha=0.7)
        
        # Formatar eixo X para mostrar strikes de forma mais legível
        if not df_expiry.empty:
            strikes = sorted(df_expiry['strike'].unique())
            if len(strikes) > 15:
                # Se houver muitos strikes, mostrar apenas alguns
                step = max(1, len(strikes) // 15)
                self.ax.set_xticks(strikes[::step])
                self.ax.set_xticklabels([f"{x:,.2f}" for x in strikes[::step]], rotation=45)
            else:
                self.ax.set_xticks(strikes)
                self.ax.set_xticklabels([f"{x:,.2f}" for x in strikes], rotation=45)
        
        # Ajustar layout
        self.fig.tight_layout()
        
        # Atualizar canvas
        self.canvas.draw()
        
        # Atualizar status
        num_calls = len(calls)
        num_puts = len(puts)
        self.status_text.set(f"Vencimento {expiry}: {num_calls} calls e {num_puts} puts (filtrado por volume mínimo: {self.min_volume.get()})")

def main():
    # Configurar janela principal
    root = tk.Tk()
    app = DolarOptionsViewer(root)
    
    # Configurar ícone se disponível
    try:
        icon_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "icon.ico")
        if os.path.exists(icon_path):
            root.iconbitmap(icon_path)
    except:
        pass  # Ignorar erros de ícone
    
    # Iniciar loop principal
    root.mainloop()

if __name__ == "__main__":
