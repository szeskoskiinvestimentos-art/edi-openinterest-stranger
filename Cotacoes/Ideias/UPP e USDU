## PASSO 5: Mapear Strikes do UUP → Níveis do USD/BRL

```python
# ============================================
# PASSO 7: Tabela de Mapeamento de Strikes
# ============================================
uup_atual = df["UUP"].iloc[-1]
usdbrl_atual = df["USDBRL"].iloc[-1]

# Strikes do UUP disponíveis nas opções
strikes_uup = [25, 26, 27, 27.5, 28, 28.5, 29, 30, 31]

print(f"\n{'='*65}")
print(f"  MAPEAMENTO DE STRIKES UUP → USD/BRL")
print(f"  UUP atual: ${uup_atual:.2f} | USD/BRL atual: R${usdbrl_atual:.4f}")
print(f"  Beta (β): {beta:.4f} | Alpha diário (α): {alpha:.6f}")
print(f"{'='*65}")
print(f"  {'Strike UUP':>12} | {'Var% UUP':>10} | {'Var% USDBRL est.':>18} | {'USDBRL Projetado':>18}")
print(f"  {'-'*12}-+-{'-'*10}-+-{'-'*18}-+-{'-'*18}")

for strike in strikes_uup:
    var_uup = (strike - uup_atual) / uup_atual
    var_usdbrl_est = alpha + beta * var_uup  # Usar alpha para movimentos grandes
    usdbrl_projetado = usdbrl_atual * (1 + var_usdbrl_est)
    
    marcador = " ◄ ATM" if abs(strike - uup_atual) < 0.3 else ""
    
    print(f"  ${strike:>10.2f} | {var_uup*100:>+9.2f}% | {var_usdbrl_est*100:>+17.2f}% | R${usdbrl_projetado:>15.4f}{marcador}")

print(f"{'='*65}")
```

