# ANÁLISE COMPLETA: UUP vs USDU vs USD/BRL
# ============================================
import yfinance as yf
import pandas as pd
import numpy as np
from scipy import stats
import matplotlib.pyplot as plt

# ============================================
# PASSO 1: Baixar dados
# ============================================
periodo = "1y"  # Use "2y" para mais robustez

uup = yf.download("UUP", period=periodo)["Close"]
usdu = yf.download("USDU", period=periodo)["Close"]
usdbrl = yf.download("USDBRL=X", period=periodo)["Close"]

# ============================================
# PASSO 2: Alinhar datas
# ============================================
df = pd.DataFrame({
    "UUP": uup,
    "USDU": usdu,
    "USDBRL": usdbrl
}).dropna()

print(f"Dias alinhados: {len(df)}")
print(f"Período: {df.index[0].date()} a {df.index[-1].date()}")
print(f"\nPreços atuais:")
print(f"  UUP:    ${df['UUP'].iloc[-1]:.2f}")
print(f"  USDU:   ${df['USDU'].iloc[-1]:.2f}")
print(f"  USDBRL: R${df['USDBRL'].iloc[-1]:.4f}")

# ============================================
# PASSO 3: Calcular retornos diários
# ============================================
df["Ret_UUP"] = df["UUP"].pct_change()
df["Ret_USDU"] = df["USDU"].pct_change()
df["Ret_USDBRL"] = df["USDBRL"].pct_change()
df = df.dropna()

# ============================================
# PASSO 4: Correlações
# ============================================
corr_uup = df["Ret_UUP"].corr(df["Ret_USDBRL"])
corr_usdu = df["Ret_USDU"].corr(df["Ret_USDBRL"])
corr_uup_usdu = df["Ret_UUP"].corr(df["Ret_USDU"])

print(f"\n{'='*55}")
print(f"  CORRELAÇÕES DE PEARSON")
print(f"{'='*55}")
print(f"  UUP  vs USD/BRL:  {corr_uup:.4f}")
print(f"  USDU vs USD/BRL:  {corr_usdu:.4f}")
print(f"  UUP  vs USDU:     {corr_uup_usdu:.4f}")
print(f"{'='*55}")

# Qual é melhor?
melhor = "USDU" if abs(corr_usdu) > abs(corr_uup) else "UUP"
print(f"\n  ✅ MELHOR PROXY: {melhor} (maior correlação com USD/BRL)")

# ============================================
# PASSO 5: Regressões Lineares
# ============================================
def calcular_regressao(x, y, nome_x, nome_y):
    slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
    r_squared = r_value**2
    
    print(f"\n{'='*55}")
    print(f"  REGRESSÃO: {nome_y} = α + β × {nome_x}")
    print(f"{'='*55}")
    print(f"  Beta (β):      {slope:.4f}")
    print(f"  Alpha (α):     {intercept:.6f} ({intercept*100:.4f}%/dia)")
    print(f"  R²:            {r_squared:.4f} ({r_squared*100:.2f}%)")
    print(f"  P-value:       {p_value:.2e}")
    print(f"  Erro padrão:   {std_err:.4f}")
    print(f"{'='*55}")
    print(f"  → Para cada +1% no {nome_x}, USD/BRL move +{slope:.2f}%")
    print(f"  → {nome_x} explica {r_squared*100:.1f}% da variação do USD/BRL")
    
    return slope, intercept, r_squared

beta_uup, alpha_uup, r2_uup = calcular_regressao(
    df["Ret_UUP"], df["Ret_USDBRL"], "UUP", "USDBRL"
)

beta_usdu, alpha_usdu, r2_usdu = calcular_regressao(
    df["Ret_USDU"], df["Ret_USDBRL"], "USDU", "USDBRL"
)

# ============================================
# PASSO 6: Tabela de Mapeamento Comparativa
# ============================================
uup_atual = df["UUP"].iloc[-1]
usdu_atual = df["USDU"].iloc[-1]
usdbrl_atual = df["USDBRL"].iloc[-1]

print(f"\n\n{'='*80}")
print(f"  MAPEAMENTO COMPARATIVO DE STRIKES → USD/BRL")
print(f"  UUP atual: ${uup_atual:.2f} | USDU atual: ${usdu_atual:.2f} | USD/BRL: R${usdbrl_atual:.4f}")
print(f"{'='*80}")

# --- Strikes do UUP ---
strikes_uup = [26.0, 27.0, 27.5, 28.0, 29.0, 30.0]

print(f"\n  📊 VIA UUP (β={beta_uup:.4f}, R²={r2_uup:.4f}):")
print(f"  {'Strike UUP':>12} | {'Var% UUP':>10} | {'USDBRL Proj.':>14} | {'Confiança':>10}")
print(f"  {'-'*12}-+-{'-'*10}-+-{'-'*14}-+-{'-'*10}")

for strike in strikes_uup:
    var = (strike - uup_atual) / uup_atual
    var_brl = alpha_uup + beta_uup * var
    brl_proj = usdbrl_atual * (1 + var_brl)
    atm = " ◄" if abs(strike - uup_atual) < 0.3 else ""
    print(f"  ${strike:>10.2f} | {var*100:>+9.2f}% | R${brl_proj:>11.4f} | ±{std_err*100:.2f}%{atm}")

# --- Strikes do USDU ---
strikes_usdu = [24.0, 25.0, 25.5, 26.0, 27.0, 28.0]

print(f"\n  📊 VIA USDU (β={beta_usdu:.4f}, R²={r2_usdu:.4f}):")
print(f"  {'Strike USDU':>12} | {'Var% USDU':>10} | {'USDBRL Proj.':>14} | {'Confiança':>10}")
print(f"  {'-'*12}-+-{'-'*10}-+-{'-'*14}-+-{'-'*10}")

for strike in strikes_usdu:
    var = (strike - usdu_atual) / usdu_atual
    var_brl = alpha_usdu + beta_usdu * var
    brl_proj = usdbrl_atual * (1 + var_brl)
    atm = " ◄" if abs(strike - usdu_atual) < 0.3 else ""
    print(f"  ${strike:>10.2f} | {var*100:>+9.2f}% | R${brl_proj:>11.4f} | ±{std_err*100:.2f}%{atm}")
