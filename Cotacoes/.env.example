# Automação (Investing) — não coloque senha/token aqui
INVESTING_PORTFOLIO_URL=

# Publish (Python) — validação e gates (opcional)
# Quando true, o publish (gerar_controle.py) aborta se o validador Node falhar/estiver indisponível.
EDI_PUBLISH_STRICT_NODE_VALIDATE=false

# Git (artefatos) — opcional
# Define a branch de artefatos (ex.: data). Quando vazia, usa main.
EDI_ARTIFACTS_BRANCH=
# Quando 1/true, os scripts `Servico_Unificado*.bat` podem commitar/pushar. Default recomendado: false.
EDI_GIT_PUSH_ENABLED=false
# Quando 1/true, os scripts `Servico_Unificado*.bat` apenas exibem branch-alvo + diff resumido (sem commit/push).
EDI_GIT_DRY_RUN=false
# Quando 1/true, os scripts `Servico_Unificado*.bat` executam `market:validate:strict` antes de commit/push (se o npm estiver disponível).
EDI_GIT_VALIDATE_STRICT=true
#
# Pipeline de publicação (branch separada) — recomendado para evitar mexer no main automaticamente
EDI_PUBLISH_BRANCH=
EDI_PUBLISH_REMOTE=origin
#
# Git Sync (Node) — comportamento perigoso só com opt-in
EDI_GIT_ALLOW_FORCE_PUSH=0
EDI_GIT_ALLOW_PULL_ON_RETRY=0

# Qual navegador usar: chromium | chrome | msedge
INVESTING_BROWSER=chrome

# Opcional (Windows): caminho do chrome.exe se necessário
INVESTING_CHROME_EXECUTABLE_PATH=

# true/false (no modo headless, se o Investing pedir captcha com frequência, use false)
INVESTING_HEADLESS=true

# Diretório base local para profile/cookies e downloads (opcional; padrão fica na raiz do projeto em .edi-market-guardin/)
MARKET_AUTOMATION_DIR=

# Opcional: sobrescreve o caminho do profile persistente (cookies/sessão)
INVESTING_USER_DATA_DIR=

# Opcional: sobrescreve a pasta de downloads do CSV
INVESTING_DOWNLOAD_DIR=

# Saída dos arquivos gerados para o dashboard (JS/JSON)
MARKET_OUT_DIR=

# Frequência de atualização do daemon (em minutos)
MARKET_INTERVAL_MINUTES=15

# Porta do serviço local que o botão ↻ Dados chama
MARKET_SERVICE_PORT=3033

# Host do serviço local
MARKET_SERVICE_HOST=127.0.0.1

# Modo do serviço de atualização: once | portfolio | calendar | di
MARKET_UPDATE_MODE=once

# Agendamento do serviço:
# - interval: roda em loop conforme MARKET_INTERVAL_MINUTES (comportamento atual)
# - cron: roda seg-sex em 8:30, depois a cada 30 min até 17:00, e 20:00 (pós-mercado)
MARKET_SCHEDULE_MODE=interval

# Cooldown (min) para evitar spam no botão ↻ Dados
MARKET_MANUAL_COOLDOWN_MINUTES=10
# Lista de subsistemas pós‑update (separados por vírgula/; ou quebras de linha). Padrão: market:addons
MARKET_SUBSYSTEMS=market:addons

# Retenção do histórico (em dias)
MARKET_RETENTION_DAYS=5
MARKET_COVERAGE_ENABLED=true
MARKET_COVERAGE_MIN_ASSETS=25
MARKET_COVERAGE_CRITICAL=USD/BRL,WDO,WIN,WDOc1,WINc1,IBOV,DXY,US10Y,VIX,BRENT,WTI,GOLD

# Retenção dos logs do serviço (market_update_*.log) em .edi-market-guardin/logs (em dias)
MARKET_UPDATE_LOG_RETENTION_DAYS=10

DADOS_DE_MERCADO_FLOW_SCRAPE_ENABLED=true
DADOS_DE_MERCADO_FLOW_URL=https://www.dadosdemercado.com.br/fluxo
DADOS_DE_MERCADO_FLOW_REFRESH_HOUR=8

# Captura DI (InfoMoney) — true/false (quando false, não adiciona DI1* no market_quotes)
INFOMONEY_DI_ENABLED=true

# Calendário Econômico (Investing widget) — true/false (quando false, não gera economic_calendar.json)
INVESTING_CALENDAR_ENABLED=true

# Opcional: URL do widget do calendário econômico (padrão já funciona)
INVESTING_ECONOMIC_CALENDAR_URL=

# Opcional: mantém o último calendário não-vazio quando a captura falhar e retornar vazio (true/false)
INVESTING_CALENDAR_KEEP_LAST_ON_EMPTY=true

# Portfolio (CSV) — quando false, não tenta exportar o CSV (útil se você só quer calendário/DI)
INVESTING_PORTFOLIO_ENABLED=true

# Intervalo mínimo do download do Portfolio (Investing) quando o serviço roda em modo schedule
# Ex.: MARKET_INTERVAL_MINUTES=5 e INVESTING_PORTFOLIO_INTERVAL_MINUTES=15 => Yahoo a cada 5min, Investing a cada 15min
INVESTING_PORTFOLIO_INTERVAL_MINUTES=15

# Seed sem browser (fallback): se o export do Investing falhar, tenta usar o CSV mais recente já salvo em disco
INVESTING_SEED_FROM_LAST_CSV=true
INVESTING_SEED_MAX_AGE_HOURS=72
# Opcional: diretórios para procurar CSV (separar por ';' ou quebra de linha). Se vazio, usa INVESTING_DOWNLOAD_DIR e a pasta do projeto Cotacoes.
INVESTING_SEED_SEARCH_DIRS=

# Validação do CSV baixado do Investing (rejeita download “errado” automaticamente e força fallback seed)
INVESTING_CSV_VALIDATE=true
INVESTING_CSV_MIN_BYTES=2048
INVESTING_CSV_MIN_ROWS=50

# Atualização de cotações via Yahoo (sem abrir navegador) — para reduzir risco de falha do Investing e permitir 5min
MARKET_YAHOO_ENABLED=true
MARKET_YAHOO_MAX_SYMBOLS=320
MARKET_YAHOO_TIMEOUT_MS=8000
# Mapeamentos pontuais (um por linha ou separado por ';'): SIMBOLO_DO_CSV=SIMBOLO_NO_YAHOO
# Ex.: USD/BRL=USDBRL=X ; .DXY=DX-Y.NYB ; .BVSP=^BVSP
MARKET_YAHOO_SYMBOL_OVERRIDES=
MARKET_YAHOO_INCLUDE_CATEGORIES=
MARKET_YAHOO_EXCLUDE_CATEGORIES=
MARKET_YAHOO_INCLUDE_SYMBOLS=
MARKET_YAHOO_EXCLUDE_SYMBOLS=
MARKET_YAHOO_NONFIXABLE_SYMBOLS=
MARKET_YAHOO_NONFIXABLE_CATEGORIES=volatility,rates,bonds
MARKET_YAHOO_DAILY_FALLBACK_ENABLED=true
MARKET_YAHOO_DAILY_FALLBACK_MAX_SYMBOLS=160
MARKET_YAHOO_PRICE_SCALE_DEFAULT=0.05,20
# Exemplos opcionais por categoria (se definido, sobrescreve o DEFAULT):
# MARKET_YAHOO_PRICE_SCALE_EQUITIES=0.2,5
# MARKET_YAHOO_PRICE_SCALE_FX_G10=0.5,2
# MARKET_YAHOO_PRICE_SCALE_FX_EMERGING=0.5,3
MARKET_YAHOO_FUTURES_SHORTCODE_AS_F=true
MARKET_YAHOO_FUTURES_MONTHCODE_AS_F=true
MARKET_YAHOO_FUTURES_ROOTS=ES,NQ,YM,RTY,CL,NG,HG,GC,SI,ZC,ZS,ZM,ZL,ZW,KE,KC,CT,CC,SB,OJ,LE,HE,PA,PL,RB,HO,BZ,LCO,ZQ
MARKET_YAHOO_ZQ_CONTRACTS_CBT=true
MARKET_YAHOO_NAME_SEARCH_ENABLED=false
MARKET_YAHOO_NAME_SEARCH_MAX=20
#
# Fallback TradingView (quando Yahoo falha / ambiguidade de ticker/exchange)
MARKET_TRADINGVIEW_FALLBACK_ENABLED=true
MARKET_TRADINGVIEW_FALLBACK_MAX=40
MARKET_TRADINGVIEW_TIMEOUT_MS=8000
#
# Overrides (um por linha ou separado por ';'): SIMBOLO_DO_CSV=EXCHANGE:TICKER
# Ex.: MAL3=LME:AH1! ; MCU=LME:CA1!
#
# Dicionário inicial (metais/LME) — útil para evitar o search quando houver ambiguidade:
# MAL3=LME:AH1!
# MCU=LME:CA1!
# MNI3=LME:NI1!
# MZN3=LME:ZS1!
# MPB3=LME:PB1!
# MSN3=LME:SN1!
#
# Exemplos adicionais:
# SHFE_PULP=SHFE:SP1!
MARKET_TRADINGVIEW_SYMBOL_OVERRIDES=
MARKET_ZQ_CURVE_ENABLED=true
MARKET_ZQ_CURVE_ROOT=ZQ=F
MARKET_ZQ_CURVE_MAX_CONTRACTS=260
MARKET_ZQ_CURVE_MONTHS_AHEAD=84
MARKET_ZQ_CURVE_MIN_CONTRACTS=0
MARKET_ZQ_CURVE_INVESTING_URL=https://br.investing.com/rates-bonds/cbot-30-day-federal-funds-comp-c1-futures-contracts

# Minério de Ferro (Dalian / DCE) via Sina (true/false)
SINA_DCE_IO_ENABLED=true
# Código do contrato contínuo usado pela API hq.sinajs.cn
SINA_DCE_IO_CODE=nf_I0

# Quando false, falha de export do CSV não derruba a execução (o calendário/DI ainda atualizam)
INVESTING_EXPORT_REQUIRED=true

# Git Sync após cada atualização do serviço (true/false)
# Quando true: faz commit automático apenas dos arquivos gerados em dashboard/MERCADO/assets/data/
MARKET_GIT_SYNC_ENABLED=true

# Quando true: após commit, faz push para o remoto
MARKET_GIT_SYNC_PUSH=false

# Remoto do push (ex.: origin)
MARKET_GIT_SYNC_REMOTE=origin

# URL do remoto (usado para bootstrap quando o remote não existe no repo).
# Não inclua token/senha na URL. Prefira HTTPS normal (com Credential Manager) ou SSH.
MARKET_GIT_SYNC_REMOTE_URL=

# Branch do push (opcional). Se vazio, faz push de HEAD.
MARKET_GIT_SYNC_BRANCH=

# (Opcional) Repositório Git a ser sincronizado (absoluto ou relativo à pasta Cotacoes)
MARKET_GIT_SYNC_REPO_DIR=

# (Opcional) Pasta dentro do repo que recebe os arquivos gerados
MARKET_GIT_SYNC_TARGET_DIR=

# (Opcional) Pasta fonte (no projeto Cotacoes) a ser commitada/copiadа
MARKET_SOURCE_DATA_DIR=dashboard/MERCADO/assets/data

# Validação de artefatos (market:validate / market:validate:strict)
# Timeout (minutos) do validador quando executado pelo market:service
MARKET_VALIDATE_TIMEOUT_MINUTES=5
# Limite de tamanho por arquivo em assets/data/*.json (default 10MB)
MARKET_VALIDATE_MAX_MB=10
MARKET_VALIDATE_MAX_BYTES=

# Timeout de segurança: se uma atualização travar (ex.: Chrome/Playwright), o serviço encerra o processo e libera o scheduler.
MARKET_UPDATE_TIMEOUT_MINUTES=25

# Trava de cobertura (anti-omissão) — impede sobrescrever market_quotes quando a coleta vem parcial
MARKET_COVERAGE_ENABLED=true
MARKET_COVERAGE_MIN_ASSETS=25
MARKET_COVERAGE_CRITICAL=USD/BRL,WDO,WIN,IBOV

# Integração Opções/Gamma (dashboard_unificado do B3_System)
# Se vazio, tenta auto-detectar em: ../B3_System/dashboard_unificado
OPTIONS_UNIFIED_DASHBOARD_DIR=

# Notícias (FinancialJuice) — usado apenas como link/atalho no dashboard
NEWS_FINANCIALJUICE_URL=

# Notícias (FinancialJuice via Discord) — para obter manchetes apesar do bloqueio do Cloudflare
# 1) Adicione o bot oficial do FinancialJuice ao seu servidor (https://features.financialjuice.com/discord/)
# 2) Crie e adicione um bot seu ao mesmo servidor, com permissão de ler mensagens no canal "newsfeed"
# 3) Preencha as variáveis abaixo
NEWS_FJ_DISCORD_ENABLED=false
NEWS_DISCORD_BOT_TOKEN=
NEWS_DISCORD_CHANNEL_ID=

# (Opcional) Armazenamento local das manchetes (mantém somente os últimos N dias)
NEWS_HEADLINES_STORE_ENABLED=true
NEWS_HEADLINES_RETENTION_DAYS=2
NEWS_HEADLINES_STORE_FILE=

# Cache e limite (evita excesso de chamadas no Discord)
NEWS_MAX_ITEMS=25
NEWS_CACHE_SECONDS=15

# Web News Module (fallback com output qualitativo, sem números)
NEWS_WEB_ENABLED=true
NEWS_WEB_WINDOW_HOURS=24
NEWS_WEB_MAX_ITEMS=40
NEWS_WEB_CACHE_SECONDS=900

# Opcional: lista de RSS (separar por vírgula, ; ou quebra de linha). Se vazio, usa uma lista padrão (Google News RSS).
NEWS_WEB_RSS_URLS=

 

# Telegram (export operacional — 3 imagens)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPERATIONAL_ENABLED=false
# manual | schedule | both
TELEGRAM_OPERATIONAL_SEND_ON=manual
TELEGRAM_OPERATIONAL_COOLDOWN_MINUTES=45
TELEGRAM_OPERATIONAL_THREAD_ID=

# Telegram (FinancialJuice -> tópico separado)
TELEGRAM_FINANCIALJUICE_ENABLED=false
TELEGRAM_FINANCIALJUICE_CHAT_ID=
TELEGRAM_FINANCIALJUICE_THREAD_ID=
TELEGRAM_FINANCIALJUICE_POLL_SECONDS=120
TELEGRAM_FINANCIALJUICE_MAX_PER_POLL=10
TELEGRAM_FINANCIALJUICE_BOOTSTRAP_MAX_ITEMS=6

# (Opcional) Store local para não reenviar IDs já postados do FinancialJuice
TELEGRAM_FINANCIALJUICE_SENT_STORE_ENABLED=true
TELEGRAM_FINANCIALJUICE_SENT_RETENTION_DAYS=7
TELEGRAM_FINANCIALJUICE_SENT_STORE_FILE=

# Exportação de PDF do dashboard MERCADO
EXPORT_DASHBOARD_PDF=true
EXPORT_PDF_OUT_DIR=
EXPORT_PDF_FILENAME_PREFIX=MERCADO

# Exportação adicional (Lite) — sem efeitos visuais/cores
EXPORT_DASHBOARD_PDF_LITE=true
EXPORT_PDF_LITE_PREFIX=MERCADO_LITE

# Export PDF Lite dos dashboards v1 de WDO/WIN (dashboard_unificado)
EXPORT_WDO_WIN_DASHBOARDS_PDF_LITE=true
EXPORT_PDF_WDO_V1_LITE_PREFIX=WDO_V1_LITE
EXPORT_PDF_WIN_V1_LITE_PREFIX=WIN_V1_LITE

# Flow Sentinel (server-side) — thresholds e pesos (opcionais; defaults no código)
FLOW_SENTINEL_NEUTRAL_THRESHOLD=
FLOW_SENTINEL_REGIME_THRESHOLD=
FLOW_SENTINEL_OIL_STRONG_THRESHOLD=
FLOW_SENTINEL_CADRUB_CONFIRM_THRESHOLD=
FLOW_SENTINEL_OIL_ADJ_REINFORCE=
FLOW_SENTINEL_VOL_BOTH_UP_REINFORCE=
FLOW_SENTINEL_VHSI_WEIGHT_DEFAULT=
FLOW_SENTINEL_VHSI_WEIGHT_ASIA=
FLOW_SENTINEL_ASIA_FUNDING_JP1Y_BPS=
FLOW_SENTINEL_ASIA_FUNDING_SLOPE_DROP_BPS=
FLOW_SENTINEL_ASIA_FUNDING_VHSI_PCT=
