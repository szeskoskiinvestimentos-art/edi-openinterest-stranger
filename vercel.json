{
  "rewrites": [
    { "source": "/dashboard_unificado/(.*)", "destination": "/dashboard_unificado/$1" },
    { "source": "/Cotacoes/(.*)", "destination": "/Cotacoes/$1" },
    { "source": "/src/(.*)", "destination": "/src/$1" },
    { "source": "/exports/(.*)", "destination": "/exports/$1" }
  ]
}