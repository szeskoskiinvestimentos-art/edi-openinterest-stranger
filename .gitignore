# ============================================
# EDI Market Guardian - .gitignore
# ============================================

# --- Arquivos de ambiente e segredos ---
.env
.env.*
.venv
venv/
*.pyc
*.pyo

# --- Arquivos de sistema e IDE ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# --- Dependências Node.js ---
node_modules/
package-lock.json

# --- Arquivos de log e debug ---
Cotacoes/.edi-market-guardin/logs/
service_logs/
Auto_B3_System/Debug/
debug_*.txt
*.log

# --- Outputs e exports (gerados) ---
exports/
controle_de_dados.html
dashboard_v1/
*.html.bak
*.tmp

# --- Dados sensíveis ---
*.env.auto
credentials.json
service-account*.json

# --- Arquivos temporários ---
*.cache
*.temp
thumbs.db

# ============================================
# PUBLICAÇÃO GITHUB PAGES
# ============================================
# Mantém rastreado apenas o que é necessário para o site:
#   - index.html (redirect)
#   - .nojekyll
#   - dashboard_unificado/ (site principal)
#   - Cotacoes/ (Market Guardian - Cotações)
#
# Todo o restante continua existindo localmente, mas não será enviado ao Git.
/*
!index.html
!.nojekyll
!Servico_Unificado.bat
!Servico_Unificado_FORCE.bat
!dashboard_unificado/
!Cotacoes/

# Dentro de dashboard_unificado, mantém tudo
!dashboard_unificado/**/*

# Dentro de Cotacoes, mantém tudo
!Cotacoes/**/*

# ============================================
# EXCLUSÕES ESPECÍFICAS (após re-inclusão de subárvores)
# Estas regras têm prioridade e sobrescrevem as anteriores
# ============================================

# Exclui node_modules dentro de Cotacoes (se existir)
Cotacoes/node_modules/

# Exclui __pycache__ Python em qualquer profundidade
__pycache__/

# Exclui exports PDF gerados pelo pipeline
Cotacoes/dashboard/MERCADO/exports/

# Exclui artefatos de execução do Chrome (Playwright) - Mantém APENAS
# arquivos de autenticação: Cookies, Login Data, Preferences, Secure Preferences, Bookmarks
Auto_B3_System/chrome_profile/Default/LOG.old
Auto_B3_System/chrome_profile/Default/LOG
