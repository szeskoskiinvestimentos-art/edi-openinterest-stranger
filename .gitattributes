# Force CRLF for Windows batch and PowerShell files
# (cmd.exe requires CRLF; LF causes "foi inesperado neste momento" errors)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts (bash) use LF
*.sh text eol=lf

# Python and TypeScript use LF
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf

# Markdown and config files use LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
